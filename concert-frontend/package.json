{
  "name": "concert-frontend",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build:music": "cd ../music && npm run build && node -e \"const fs=require('fs');let h=fs.readFileSync('./dist/index.html','utf8');h=h.replace(/src=\\\"\\/music\\//g,'src=\\\"./').replace(/href=\\\"\\/music\\//g,'href=\\\"./');fs.writeFileSync('./dist/index.html',h);\"",
    "copy:music": "node -e \"const fs=require('fs');const p=require('path');const dst='./public/music';['assets','index.html'].forEach(f=>{try{fs.rmSync(p.join(dst,f),{recursive:true})}catch(e){}});fs.mkdirSync(dst,{recursive:true});fs.cpSync('../music/dist',dst,{recursive:true,filter:(s)=>s.endsWith('index.html')||s.includes('/assets/')});fs.readdirSync('../music/1').forEach(a=>fs.cpSync(p.join('../music/1',a),p.join(dst,a),{recursive:true}));\"",
    "build": "npm run build:music && npm run copy:music && vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "@react-three/drei": "^9.108.0",
    "@react-three/fiber": "^8.16.0",
    "@stomp/stompjs": "^6.1.2",
    "axios": "^1.7.2",
    "date-fns": "^3.6.0",
    "events": "^3.3.0",
    "framer-motion": "^11.0.0",
    "jsmediatags": "^3.9.7",
    "lucide-react": "^0.400.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "react-markdown": "^9.0.0",
    "react-router-dom": "^6.24.0",
    "remark-gfm": "^4.0.0",
    "sockjs-client": "^1.6.1",
    "three": "^0.166.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "autoprefixer": "^10.4.0",
    "postcss": "^8.4.0",
    "tailwindcss": "^3.4.0",
    "vite": "^5.4.0"
  }
}
